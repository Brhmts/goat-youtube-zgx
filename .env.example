# Kie.ai API Key (required — powers image gen, video gen, TTS and reference uploads)
# Get yours at: https://kie.ai/dashboard/api-keys
KIE_AI_API_KEY=your_key_here

# ElevenLabs direct (optional — fallback when Kie.ai TTS fails).
# Voices are set per character in public/series/<id>/series.json (voice.kie / voice.elevenLabsId).
ELEVENLABS_API_KEY=

# Optional: render with an installed Chrome/Chromium instead of Remotion's download
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
