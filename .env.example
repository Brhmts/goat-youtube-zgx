# Kie.ai API Key (required — powers image gen, video gen, and TTS)
# Get yours at: https://kie.ai/dashboard/api-keys
KIE_AI_API_KEY=your_key_here

# Voice used through Kie.ai — an ElevenLabs voice NAME (e.g. Daniel, Aria)
ELEVENLABS_VOICE_NAME=Daniel

# ElevenLabs direct (optional — used if KIE_AI_API_KEY is missing or Kie TTS fails)
ELEVENLABS_API_KEY=
# The direct API needs a voice ID, not a name (default: Daniel = onwK4e9ZLuTAKqWW03F9)
ELEVENLABS_VOICE_ID=
